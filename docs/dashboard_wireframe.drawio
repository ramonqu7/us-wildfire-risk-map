        <!-- Left Panel: What-If Sliders -->
        <mxCell id="p1" value="&lt;b&gt;① Interactive &#39;What-If&#39; Drivers&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Addresses Diehl et al. 2017 &amp;amp; Rollins 2009)&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;• Energy Release (ERC): &lt;b&gt;84 (92nd %ile)&lt;/b&gt;&lt;br&gt;[==========|==] &lt;br&gt;&lt;br&gt;• Vapor Press. Deficit (VPD): &lt;b&gt;2.6 kPa&lt;/b&gt;&lt;br&gt;[=========|===]&lt;br&gt;&lt;br&gt;• 10m Wind Speed: &lt;b&gt;22 mph&lt;/b&gt;&lt;br&gt;[========|====]&lt;br&gt;&lt;br&gt;• Relative Humidity (RH): &lt;b&gt;16%&lt;/b&gt;&lt;br&gt;[==|==========]&lt;br&gt;&lt;br&gt;• Terrain Slope: &lt;b&gt;14° Steep&lt;/b&gt;&lt;br&gt;[=======|=====]&lt;br&gt;&lt;br&gt;• Canopy Cover (EVC): &lt;b&gt;62% Dense&lt;/b&gt;&lt;br&gt;[=======|=====]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="260" height="390" as="geometry" />
        </mxCell>
        <!-- Bottom-Left: GMM Soft Regime Bar -->
        <mxCell id="p2" value="&lt;b&gt;② GMM Soft Regime Probabilities γ_k(x)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Supports soft CBR matching — Serra et al. 2025)&lt;/i&gt;&lt;hr&gt;&lt;b style=&quot;color:#991B1B&quot;&gt;[ 68% R2 Montane ]&lt;/b&gt; &lt;b style=&quot;color:#EA580C&quot;&gt;[ 24% R1 Arid ]&lt;/b&gt; [8% R3]&lt;br&gt;• Prior weights condition historical fire retrieval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;verticalAlign=top;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
