        <!-- Center-Bottom: Verbal Framing Banner -->
        <mxCell id="p4" value="&lt;b style=&quot;color:#9A3412&quot;&gt;④ Synchronized Verbal Frequency Framing &amp;amp; 10th–90th %ile Burned-Area Range&lt;/b&gt; &lt;i&gt;(Zimnicki &amp;amp; Matzen 2026)&lt;/i&gt;&lt;hr&gt;&lt;b&gt;“High Escalation Risk (24% probability — about 1 in 4 historical fires under these exact conditions exceeded 300 acres).”&lt;/b&gt;&lt;br&gt;&lt;br&gt;10th–90th Percentile Analog Interval: &lt;b style=&quot;background:#FED7AA;padding:2px 6px;&quot;&gt;p10: 18 ac&lt;/b&gt; — &lt;b style=&quot;background:#EA580C;color:#FFF;padding:2px 8px;&quot;&gt;Median: 340 ac&lt;/b&gt; — &lt;b style=&quot;background:#FED7AA;padding:2px 6px;&quot;&gt;p90: 4,850 ac&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px;color:#475569;&quot;&gt;⚠ Limitation Note: Historical fire twins reflect empirical outcomes under matching drivers, not a deterministic perimeter forecast.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="305" y="455" width="490" height="175" as="geometry" />
