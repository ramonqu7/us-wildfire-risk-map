        <!-- Top Header -->
        <mxCell id="hdr" value="FireTwin-US  |  Interactive US Wildfire Risk &amp; Historical Fire Twin Dashboard   [Search County/ZIP: Boulder County, CO]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1100" height="45" as="geometry" />
